 private:
 
+  // Configures fault injection from the environment, in priority order:
+  //   1) FAULT_TIMESTAMP + FAULT_BIT_INDEX -> deterministic single-shot:
+  //      exactly one fault, at the exact timestamp, with the exact dart.
+  //   2) FAULT_MULTI_BITS -> multi-injection: K faults in the same run on a
+  //      fixed bit (or a bit drawn per fault from a range), see
+  //      configure_multi_fault().
+  //   3) FAULT_RANDOM_MAX_TIMESTAMP -> random single-shot: exactly one
+  //      fault, at a timestamp drawn uniformly from [150, max], with a
+  //      randomly chosen dart (same as the default schedule's draw).
+  //   4) none -> default continuous random fault schedule (unchanged).
+  void configure_fault_injection() {
+    if (this->configure_deterministic_fault()) {
+      return;
+    }
+    if (this->configure_multi_fault()) {
+      return;
+    }
+    this->configure_random_single_shot_fault();
+  }
+
+  // Multi-injection mode (accelerated campaigns on small structures).
+  //   FAULT_MULTI_BITS        "B"     -> every fault flips ruler index B
+  //                           "L-H"   -> each fault flips an index drawn
+  //                                      uniformly from [L, H]
+  //   FAULT_MULTI_TIMESTAMPS  "t1,t2,..." explicit schedule (testing), or
+  //   FAULT_MULTI_COUNT=K + FAULT_RANDOM_MAX_TIMESTAMP=MAX
+  //                           -> K distinct EVEN timestamps drawn uniformly
+  //                              from [150, MAX] (injection only happens on
+  //                              even timestamps, see tick()).
+  // Each fault prints the usual {"type":"injection",...} line, so the runner
+  // stores all of them in the Injection table. Returns false (and the next
+  // mode is tried) if FAULT_MULTI_BITS is unset or invalid.
+  bool configure_multi_fault() {
+    const char* bits_env = std::getenv("FAULT_MULTI_BITS");
+    if (!bits_env) {
+      return false;
+    }
+
+    // ---- bits: "B" or "L-H" ----
+    uint64_t lo = 0, hi = 0;
+    {
+      std::string spec(bits_env);
+      auto dash = spec.find('-');
+      char* end = nullptr;
+      std::string a = spec.substr(0, dash);
+      lo = std::strtoull(a.c_str(), &end, 10);
+      bool ok = !a.empty() && *end == '\0';
+      hi = lo;
+      if (dash != std::string::npos) {
+        std::string b = spec.substr(dash + 1);
+        hi = std::strtoull(b.c_str(), &end, 10);
+        ok = ok && !b.empty() && *end == '\0';
+      }
+      if (!ok || lo > hi || hi >= BIT_TOTALI_VORTEX) {
+        std::cerr << "[Fault Injection] Error: FAULT_MULTI_BITS='" << bits_env
+                  << "' is not 'B' or 'L-H' with L <= H < " << BIT_TOTALI_VORTEX
+                  << "; aborting." << std::endl;
+        std::exit(2);
+      }
+    }
+
+    std::mt19937_64 gen(std::random_device{}());
+    std::vector<uint64_t> times;
+
+    // ---- timestamps: explicit list, or K random distinct even values ----
+    const char* list_env = std::getenv("FAULT_MULTI_TIMESTAMPS");
+    if (list_env) {
+      std::stringstream ss(list_env);
+      std::string tok;
+      while (std::getline(ss, tok, ',')) {
+        char* end = nullptr;
+        uint64_t t = std::strtoull(tok.c_str(), &end, 10);
+        if (tok.empty() || *end != '\0') {
+          std::cerr << "[Fault Injection] Error: bad FAULT_MULTI_TIMESTAMPS entry '" << tok
+                    << "'; aborting." << std::endl;
+          std::exit(2);
+        }
+        times.push_back(t);
+      }
+    } else {
+      const char* k_env   = std::getenv("FAULT_MULTI_COUNT");
+      const char* max_env = std::getenv("FAULT_RANDOM_MAX_TIMESTAMP");
+      char* end1 = nullptr;
+      char* end2 = nullptr;
+      uint64_t k   = k_env   ? std::strtoull(k_env, &end1, 10) : 0;
+      uint64_t max = max_env ? std::strtoull(max_env, &end2, 10) : 0;
+      const uint64_t min_ts = 150;
+      bool ok = k_env && max_env && *end1 == '\0' && *end2 == '\0' && k >= 1 && max >= min_ts;
+      // even values in [min_ts, max]: 2*j for j in [ceil(min/2), floor(max/2)]
+      uint64_t jlo = (min_ts + 1) / 2, jhi = max / 2;
+      if (!ok || jhi < jlo || k > jhi - jlo + 1) {
+        std::cerr << "[Fault Injection] Error: multi mode needs FAULT_MULTI_TIMESTAMPS, or "
+                     "FAULT_MULTI_COUNT=K >= 1 and FAULT_RANDOM_MAX_TIMESTAMP >= " << min_ts
+                  << " with K <= number of even timestamps; aborting." << std::endl;
+        std::exit(2);
+      }
+      std::uniform_int_distribution<uint64_t> dist(jlo, jhi);
+      std::set<uint64_t> drawn;
+      while (drawn.size() < k) {
+        drawn.insert(2 * dist(gen));
+      }
+      times.assign(drawn.begin(), drawn.end());
+    }
+    std::sort(times.begin(), times.end());
+
+    // ---- one dart per fault ----
+    std::uniform_int_distribution<uint64_t> bit_dist(lo, hi);
+    multi_schedule_.clear();
+    for (uint64_t t : times) {
+      multi_schedule_.emplace_back(t, static_cast<uint32_t>(lo == hi ? lo : bit_dist(gen)));
+    }
+    multi_next_ = 0;
+    multi_mode_ = true;
+
+    std::cerr << "[Fault Injection] Multi-injection mode: " << multi_schedule_.size()
+              << " faults, bits " << lo << (lo == hi ? "" : "-" + std::to_string(hi)) << ", timestamps";
+    for (auto& f : multi_schedule_) {
+      std::cerr << " " << f.first;
+    }
+    std::cerr << std::endl;
+    return true;
+  }
+
+  // Returns true if deterministic single-shot mode was successfully
+  // enabled from FAULT_TIMESTAMP/FAULT_BIT_INDEX.
+  bool configure_deterministic_fault() {
+    const char* ts_env  = std::getenv("FAULT_TIMESTAMP");
+    const char* bit_env = std::getenv("FAULT_BIT_INDEX");
+
+    if (!ts_env && !bit_env) {
+      return false;
+    }
+
+    if (!ts_env || !bit_env) {
+      std::cerr << "[Fault Injection] Warning: only one of FAULT_TIMESTAMP/FAULT_BIT_INDEX is set; "
+                    "both are required for deterministic single-shot mode. Ignoring." << std::endl;
+      return false;
+    }
+
+    char* end = nullptr;
+    uint64_t ts = std::strtoull(ts_env, &end, 10);
+    bool ts_ok = (end != ts_env) && (*end == '\0');
+
+    end = nullptr;
+    uint64_t bit = std::strtoull(bit_env, &end, 10);
+    bool bit_ok = (end != bit_env) && (*end == '\0') && (bit <= 0xFFFFFFFFull);
+
+    if (!ts_ok || !bit_ok) {
+      std::cerr << "[Fault Injection] Warning: FAULT_TIMESTAMP/FAULT_BIT_INDEX set but could not "
+                    "be parsed as integers; ignoring." << std::endl;
+      return false;
+    }
+
+    single_shot_mode_ = true;
+    fault_dart_fixed_ = true;
+    fault_timestamp_  = ts;
+    fault_dart_       = static_cast<uint32_t>(bit);
+    std::cerr << "[Fault Injection] Deterministic single-shot mode: timestamp=" << fault_timestamp_
+               << ", bit_index=" << fault_dart_ << std::endl;
+    return true;
+  }
+
+  // Enables random single-shot mode from FAULT_RANDOM_MAX_TIMESTAMP, if set
+  // and valid. Falls through silently (default schedule) otherwise.
+  void configure_random_single_shot_fault() {
+    const char* max_env = std::getenv("FAULT_RANDOM_MAX_TIMESTAMP");
+    if (!max_env) {
+      return;
+    }
+
+    char* end = nullptr;
+    uint64_t max_ts = std::strtoull(max_env, &end, 10);
+    bool max_ok = (end != max_env) && (*end == '\0');
+
+    const uint64_t min_ts = 150;
+    if (!max_ok || max_ts < min_ts) {
+      std::cerr << "[Fault Injection] Warning: FAULT_RANDOM_MAX_TIMESTAMP could not be parsed or is "
+                    "less than " << min_ts << "; falling back to default random fault schedule." << std::endl;
+      return;
+    }
+
+    std::mt19937_64 gen(std::random_device{}());
+    std::uniform_int_distribution<uint64_t> dist(min_ts, max_ts);
+
+    single_shot_mode_ = true;
+    fault_dart_fixed_ = false;
+    fault_timestamp_  = dist(gen);
+    std::cerr << "[Fault Injection] Random single-shot mode: timestamp=" << fault_timestamp_
+               << " (drawn from [" << min_ts << ", " << max_ts << "])" << std::endl;
+  }
+
   void reset() {
     this->mem_bus_reset();
     this->dcr_bus_reset();
